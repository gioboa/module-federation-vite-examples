<section class="host card">
	<div class="icon" aria-hidden="true">
		<svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
			<path d="M316.01 199.02 256.134 14.817 196.239 199.02H1.134l158.102 113.324L98.53 496.487l157.604-114.232 157.585 114.232-60.687-184.143L511.134 199.02H316.01Zm19.074 119.237 42.407 128.63-110.271-79.924-11.086-8.033-11.086 8.033-110.291 79.923 42.408-128.63 4.353-13.18-11.289-8.08L59.903 217.909h136.336l13.724-13.051 41.929-128.957 41.91 128.957 4.242 13.051h13.724h136.336l-110.327 79.088-11.27 8.08 4.177 13.18Z" />
		</svg>
	</div>
	<h1>I'm the host app</h1>
	<button type="button" data-counter="Host">Host counter: 0</button>
</section>

<style>
	.card {
		box-sizing: border-box;
		width: 250px;
		padding: 20px;
		border-radius: 5px;
		box-shadow: 0 0 20px rgb(0 0 0 / 40%);
		text-align: center;
		color: white;
	}

	.host {
		background: #3178c6;
	}

	.icon svg {
		width: 100px;
		height: 100px;
	}

	.icon path {
		fill: #f6b352;
	}

	h1 {
		margin: 10px 0 0;
		font-size: 25px;
	}

	button {
		margin-top: 10px;
		border: 0;
		border-radius: 0.25rem;
		padding: 0.5rem 1rem;
		background: #f6b352;
		font: 700 1rem inherit;
		color: #181818;
		cursor: pointer;
	}
</style>
