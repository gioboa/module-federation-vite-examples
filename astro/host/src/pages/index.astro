---
import HostCard from '../components/HostCard.astro';
import RemoteCard from 'astro_remote/components/RemoteCard';
---

<main>
	<HostCard />
	<RemoteCard />
</main>

<script is:inline src="/counter.js"></script>

<style>
	:global(html),
	:global(body) {
		margin: 0;
		min-height: 100%;
	}

	main {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		padding: 20px;
	}
</style>
