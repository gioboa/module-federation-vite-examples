<style>
	.card {
		box-sizing: border-box;
		width: 250px;
		padding: 20px;
		border-radius: 5px;
		box-shadow: 0 0 20px rgb(0 0 0 / 40%);
		text-align: center;
		color: white;
	}

	.remote {
		background: #1f2124;
	}

	.icon svg {
		width: 100px;
		height: 100px;
	}

	.icon path {
		fill: #f6b352;
	}

	h1 {
		margin: 10px 0 0;
		font-size: 25px;
	}

	button {
		margin-top: 10px;
		border: 0;
		border-radius: 0.25rem;
		padding: 0.5rem 1rem;
		background: #f6b352;
		font: 700 1rem inherit;
		color: #181818;
		cursor: pointer;
	}
</style>
